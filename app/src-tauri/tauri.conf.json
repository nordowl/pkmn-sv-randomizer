{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SV Randomizer",
  "mainBinaryName": "SV Randomizer",
  "version": "0.1.0",
  "identifier": "dev.svrandomizer.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SV Randomizer",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 660,
        "backgroundColor": "#0d0c10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
