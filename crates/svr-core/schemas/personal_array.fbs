// avalon/data/personal_array.bin on Scarlet/Violet 4.0.0. The game ships no .bfbs for this table.
// Widths were measured from field spacing and alignment across all 1,424 rows.
// tests/fb_tables.rs checks that every row's vtable and every non-zero byte is accounted for.

file_extension "bin";

// 24 bytes aligned to 4: the three reserved words are in every row and always zero.
struct PersonalSpecies {
    // The game's internal id. It differs from national_dex on 134 rows, all from Gen 9 onward.
    species: ushort;
    form: ushort;
    national_dex: ushort;
    color: ubyte;
    body_type: ubyte;
    height: ushort;
    weight: ushort;
    reserved0: uint;
    reserved1: uint;
    reserved2: uint;
}

struct PersonalGender {
    group: ubyte;
    ratio: ubyte;
}

struct PersonalHatch {
    species: ushort;
    form: ushort;
    form_flags: ushort;
    form_everstone: ushort;
}

struct PersonalStats {
    hp: ubyte;
    atk: ubyte;
    def: ubyte;
    spa: ubyte;
    spd: ubyte;
    spe: ubyte;
}

struct PersonalEvolution {
    level: ushort;
    condition: ushort;
    parameter: ushort;
    reserved3: ushort;
    reserved4: ushort;
    reserved5: ushort;
    species: ushort;
    form: ushort;
}

struct PersonalLevelUpMove {
    move: ushort;
    // Signed: -3 marks a move learned on evolution.
    level: byte;
}

table Personal {
    species: PersonalSpecies;
    is_present: bool;
    // A plain ushort. A {ushort, ubyte} struct would be 4 bytes, but is_present sits 3 bytes after
    // this field in all 522 rows that have it.
    paldea_dex: ushort;
    kitakami_dex: ushort;
    blueberry_dex: ushort;
    type_1: ubyte;
    type_2: ubyte;
    ability_1: ushort;
    ability_2: ushort;
    ability_hidden: ushort;
    xp_growth: ubyte;
    catch_rate: ubyte;
    gender: PersonalGender;
    egg_group_1: ubyte;
    egg_group_2: ubyte;
    egg_hatch: PersonalHatch;
    egg_hatch_steps: ubyte;
    base_friendship: ubyte;
    exp_addend: short;
    evo_stage: ubyte;
    type_change_disallowed: bool;
    ev_yield: PersonalStats;
    base_stats: PersonalStats;
    evolutions: [PersonalEvolution];
    tm_moves: [ushort];
    egg_moves: [ushort];
    reminder_moves: [ushort];
    levelup_moves: [PersonalLevelUpMove];
}

table PersonalTable {
    entry: [Personal];
}

root_type PersonalTable;
